# Sentinel Environment Configuration

# Core LLM
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Observability (Self-hosted or Cloud Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_ENABLED=true

# LangGraph PostgreSQL Checkpointer
POSTGRES_URI=postgresql://postgres:postgrespassword@localhost:5432/sentinel
USE_SQLITE_FALLBACK=true

# GitHub Integration
GITHUB_TOKEN=ghp_...

# Sandbox Configurations
SANDBOX_BACKEND=auto  # Options: auto, docker, local
SANDBOX_DOCKER_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPU_LIMIT=2.0
MAX_REPAIR_RETRIES=3
